{
    "key": "synthetic-first-year-2026",
    "label": "Typical first-year application (practice snapshot)",
    "note": "A practice copy of the sections most first-year applications ask for — not the live portal. With the AdmitMe browser extension, plain details from your profile (name, email, country…) can be typed into the real form after you approve each one; everything else you enter yourself.",
    "sections": [
        {
            "title": "Profile",
            "fields": [
                {
                    "key": "legal_name",
                    "label": "Legal name",
                    "required": true,
                    "source": "user.name",
                    "fill": true
                },
                {
                    "key": "email",
                    "label": "Email",
                    "required": true,
                    "source": "user.email",
                    "fill": true
                },
                {
                    "key": "country",
                    "label": "Country of residence",
                    "required": true,
                    "source": "profile.location_country",
                    "fill": true
                },
                {
                    "key": "citizenship",
                    "label": "Citizenship",
                    "required": true,
                    "source": "profile.citizenship_residency",
                    "fill": true
                }
            ]
        },
        {
            "title": "Education",
            "fields": [
                {
                    "key": "current_year",
                    "label": "Current year in school",
                    "required": true,
                    "source": "profile.current_grade",
                    "fill": true
                },
                {
                    "key": "graduation_year",
                    "label": "Graduation year",
                    "required": true,
