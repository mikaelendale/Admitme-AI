APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
# Optional: Laravel logging channel for MAIL_MAILER=log (default: same as LOG_CHANNEL)
# MAIL_LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Broadcasting: use `reverb` locally with `php artisan reverb:start` (see composer dev script). `log` avoids websocket in tests.
BROADCAST_CONNECTION=reverb

# Laravel Reverb (defaults match reverb:install)
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Stripe (Cashier) — set price IDs from Stripe Dashboard for onboarding checkout
# Webhook endpoint (default): POST https://your-domain.test/stripe/webhook — add STRIPE_WEBHOOK_SECRET from Stripe CLI or Dashboard
# STRIPE_KEY=
# STRIPE_SECRET=
# STRIPE_WEBHOOK_SECRET=
# Customer Portal: Stripe Dashboard → Settings → Customer portal — enable subscription update/cancel and payment methods.
# Optional: STRIPE_BILLING_PORTAL_CONFIGURATION=bpc_... if you use a saved portal configuration.
# When true, only the $1 trial (onboarding) is available for new purchases; Sprint, Pro, and Boost checkouts are disabled.
BILLING_TRIAL_ONLY=false

STRIPE_PRICE_TRIAL=
STRIPE_PRICE_SPRINT=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_BOOST=

# Time-boxed access for one-time trial/sprint checkouts (days). Boost does not grant a pass.
# BILLING_ENFORCE_PURCHASE_ACCESS=false is typical in automated tests (see phpunit.xml).
# BILLING_TRIAL_ACCESS_DAYS=3
# BILLING_SPRINT_ACCESS_DAYS=90
# Max PDF resume imports for trial/sprint (one-time) passes; Pro subscribers are unlimited.
# BILLING_PROFILE_MAX_PDF_RESUME_PARSES_PASS=3
# BILLING_ENFORCE_PURCHASE_ACCESS=true

# Bump when Privacy Policy / Terms change (stored with onboarding acceptance)
LEGAL_DOCUMENTS_VERSION=1.0.0

# Onboarding profile paste (word count cap)
ADMISSIONS_MAX_PROFILE_WORDS=2000

# Laravel AI — keys live in config/ai.php; which provider/model each agent uses is in config/admitme.php
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Provider for every AdmitMe agent (openai | anthropic | gemini); its key above must be valid.
# ADMITME_AI_PROVIDER=openai
# ADMITME_OPENAI_MODEL=gpt-5-nano
# ADMITME_ANTHROPIC_MODEL=claude-haiku-5-5
# Optional: run only the mentor (or conversation summaries) on another provider/model
# The mentor uses Claude when ANTHROPIC_API_KEY is set, else ADMITME_AI_PROVIDER; it gets a stronger model than background agents.
# ADMITME_MENTOR_PROVIDER=
# ADMITME_MENTOR_MODEL=
# ADMITME_MENTOR_ANTHROPIC_MODEL=claude-sonnet-5-5
# ADMITME_MENTOR_OPENAI_MODEL=gpt-5.5
# ADMITME_SUMMARY_PROVIDER=
# ADMITME_SUMMARY_MODEL=
# Mentor default chat mode when a request does not say (ask = read-only, agent = can propose/act)
# ADMITME_MENTOR_DEFAULT_MODE=ask
# Context budgets (estimated tokens, characters / 4)
# ADMITME_CONTEXT_TARGET_TOKENS=8000
# ADMITME_CONTEXT_MEMORY_TOKENS=1800
# ADMITME_CONTEXT_HISTORY_TOKENS=4000
# Days before an undecided approval proposal expires
# ADMITME_PROPOSAL_EXPIRY_DAYS=7
# OpenAI web search on the dashboard general agent (default on in config/admissions.php; set false to disable)
# ADMITME_GENERAL_AGENT_WEB_SEARCH=true
# Optional: log PromptingAgent / StreamingAgent / tool events at debug (see LogLaravelAiSdkTelemetry)
# ADMITME_LOG_AI_SDK_EVENTS=false
# Knowledge base: days before a source counts as stale; local fixture hosts and plain http are for development only
# ADMITME_KNOWLEDGE_STALE_DAYS=30
# ADMITME_KNOWLEDGE_EXTRA_HOSTS=
# ADMITME_KNOWLEDGE_ALLOW_HTTP=false
# Background tasks: concurrency per student and overall, worker lease, retry backoff, provider calls per minute
# ADMITME_TASKS_MAX_RUNNING=3
# ADMITME_TASKS_MAX_RUNNING_GLOBAL=20
# ADMITME_TASKS_LEASE_SECONDS=900
# ADMITME_TASKS_RETRY_BACKOFF=20
# ADMITME_TASKS_PROVIDER_CALLS_PER_MINUTE=30
# Writing coach policy when a college has none recorded (no_ai_assistance | feedback_only | light_editing)
# ADMITME_WRITING_DEFAULT_POLICY=feedback_only
# Retention: export download window (hours), run records and browser observations (days)
# ADMITME_EXPORT_EXPIRES_HOURS=24
# ADMITME_CONTEXT_SNAPSHOT_DAYS=90
# ADMITME_BROWSER_SNAPSHOT_DAYS=30
# Browser extension: seconds a fill step is held before it is reconciled and handed out again
# ADMITME_BROWSER_LEASE_SECONDS=60

# College list council (queued multi-agent pipeline + Reverb feed). When false, general agent uses sync RunCollegeListAgentTool.
COLLEGE_LIST_COUNCIL_ENABLED=true
# Max POST /college-lists/council-runs per user per day (rolling 24h).
# COLLEGE_LIST_COUNCIL_DAILY_LIMIT=5
# Pause the council job after the auditor for optional clarifications in the live card; auto-continues after timeout.
# COLLEGE_LIST_PAUSE_PREFLIGHT_IN_JOB=true
# COLLEGE_LIST_PREFLIGHT_AUTO_CONTINUE_SECONDS=120
# Set true in PHPUnit to skip real LLM in council job tests (see tests/Feature/CollegeListCouncilJobTest.php)
# COLLEGE_LIST_COUNCIL_FAKE_PHASES=false
# Council milestone logs (preflight/scout/judge/assembly). Optional dedicated file: config/logging.php channel college_list_council
# COLLEGE_LIST_COUNCIL_LOG_MILESTONES=true
# COLLEGE_LIST_COUNCIL_LOG_CHANNEL=college_list_council
# COLLEGE_LIST_COUNCIL_LOG_LEVEL=debug
# Per-call OpenAI HTTP timeouts (seconds) for council agents — raise if you see cURL 28 during scout/judge.
# COLLEGE_LIST_AUDITOR_LLM_TIMEOUT=180
# COLLEGE_LIST_SCOUT_LLM_TIMEOUT=420
# COLLEGE_LIST_JUDGE_LLM_TIMEOUT=300

# Gap + Fix Engine (see config/gap_fix.php). PHPUnit sets GAP_FIX_FAKE=true to skip LLM.
# GAP_FIX_FAKE=false
# GAP_FIX_GENERATE_PER_HOUR=4
# GAP_FIX_WHAT_IF_EXPLAIN_PER_HOUR=10

# Essay suite (see config/essay_suite.php). PHPUnit sets ESSAY_SUITE_FAKE=true to skip LLM on roast / why / score-only.
# ESSAY_SUITE_FAKE=false
# ESSAY_SUITE_ROAST_PER_HOUR=5
# ESSAY_SUITE_WHY_SCHOOL_PER_HOUR=10
# ESSAY_SUITE_SCORE_ONLY_PER_HOUR=10

# Google OAuth (Laravel Socialite)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
